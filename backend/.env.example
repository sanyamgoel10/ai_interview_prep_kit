# Server
PORT=3001

# Database
MONGODB_URI=mongodb://localhost:27017/interview_prep

# Auth - generate a strong random string for production
JWT_SECRET=your_jwt_secret_here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

NODE_ENV=development

# ── LLM Configuration ──────────────────────────────────────────────────────────
# Provider: gemini | groq | openrouter | openai-compatible  (default: gemini)
LLM_PROVIDER=gemini

# Model override — leave blank to use the provider default shown below
#   gemini     → gemini-1.5-flash       (1,500 req/day free)
#   groq       → llama-3.3-70b-versatile (14,400 req/day free, very fast)
#   openrouter → meta-llama/llama-3.1-8b-instruct:free  (rate-limited free)
LLM_MODEL=

# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key — https://console.groq.com  (set LLM_PROVIDER=groq to activate)
GROQ_API_KEY=

# OpenRouter API key — https://openrouter.ai/keys  (set LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=

# Any OpenAI-compatible endpoint  (set LLM_PROVIDER=openai-compatible)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
